# Copy to `.streamlit/secrets.toml` for LOCAL Google Sheets testing, or paste the
# same content into Streamlit Cloud → app → Settings → Secrets for production.
# The real secrets.toml is git-ignored. Fill every value from your service-account
# JSON key. Copy `private_key` verbatim, keeping the literal \n sequences.

[gcp_service_account]
type = "service_account"
project_id = "africax-485504"
private_key_id = "REPLACE_ME"
private_key = "-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
client_email = "africax-writer@africax-485504.iam.gserviceaccount.com"
client_id = "REPLACE_ME"
token_uri = "https://oauth2.googleapis.com/token"

[africax_sheet]
# The full URL of the Google Sheet you shared with the service-account email above.
url = "https://docs.google.com/spreadsheets/d/REPLACE_WITH_SHEET_ID/edit"
